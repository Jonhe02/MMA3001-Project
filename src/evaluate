
"""Evaluate the trained two-class YOLO packaging defect detector."""

from pathlib import Path
from ultralytics import YOLO

PROJECT_ROOT = Path(__file__).resolve().parent.parent

# Update this folder if Ultralytics added a numerical suffix.
RUN_NAME = "yolo11n_2class_v2"


def main():
    """Evaluate the best YOLO11n checkpoint on validation images."""

    weights = (
    PROJECT_ROOT / "runs"
    / "yolo11s_2class_v2"
    / "weights" / "best.pt"
    )

    dataset = (
        PROJECT_ROOT / "data"
        / "4 - two_class_v2" / "data.yaml"
    )

    if not weights.is_file():
        raise FileNotFoundError(f"Model weights not found: {weights}")

    model = YOLO(str(weights))

    metrics = model.val(
        data=str(dataset),
        split="val",
        imgsz=640,
        batch=4,
        device=0,
        workers=0,
        plots=True,
        project=str(PROJECT_ROOT / "runs"),
        name="yolo11n_validation"
    )

    print("\n--- Overall Validation Results ---")
    print(f"Precision: {metrics.box.mp:.4f}")
    print(f"Recall: {metrics.box.mr:.4f}")
    print(f"mAP50: {metrics.box.map50:.4f}")
    print(f"mAP50-95: {metrics.box.map:.4f}")

    print("\n--- Per-Class mAP50-95 ---")
    for class_id in metrics.box.ap_class_index:
        class_id = int(class_id)
        print(
            f"{model.names[class_id]}: "
            f"{metrics.box.maps[class_id]:.4f}"
        )

    print("\n--- Processing Time (ms/image) ---")
    for stage, time_ms in metrics.speed.items():
        print(f"{stage}: {time_ms:.2f}")


if __name__ == "__main__":
    main()

"""Evaluate a trained YOLO packaging defect detector."""

from ultralytics import YOLO


def main():
    """Measure detection quality on validation images."""

    model = YOLO(
        "runs/yolo11n_baseline/weights/best.pt"
    )

    metrics = model.val(
        data="data/data.yaml",
        split="val",
        imgsz=640,
        batch=4,
        device=0,
        project="runs",
        name="baseline_validation"
    )

    print(f"Precision: {metrics.box.mp:.4f}")
    print(f"Recall: {metrics.box.mr:.4f}")
    print(f"mAP50: {metrics.box.map50:.4f}")
    print(f"mAP50-95: {metrics.box.map:.4f}")


if __name__ == "__main__":
    main()